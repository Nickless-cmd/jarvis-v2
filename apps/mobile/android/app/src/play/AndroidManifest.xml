<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

  <!-- Play-varianten (28/9-2026). Denne fil merges KUN ind i `play`-bygget;
       `release` (sideload) er uberoert og beholder alle tilladelser.

       `tools:node="remove"` fjerner noden efter merger — ogsaa naar den kommer
       fra en andens manifest (expo-location erklærer selv baggrundslokationens
       <service>, og hovedmanifestet erklærer tilladelserne). Uden `remove`
       ville merger'en bare lægge dem sammen.

       Konsekvens for brugeren i Play-bygget:
       · Baggrundslokation kan ikke slaaes til. `requestBackgroundPermissionsAsync()`
         returnerer ikke «granted», og backgroundLocation.ts falder tilbage til
         forgrunds-ping (den har allerede den gren).
       · Appen kan ikke laengere opdatere sig selv — Play tager over. -->
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
                   tools:node="remove"/>
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
                   tools:node="remove"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"
                   tools:node="remove"/>

  <!-- Baggrundslokationens foreground-service. Uden ACCESS_BACKGROUND_LOCATION
       kan LocationTaskService alligevel ikke starte — og en deklareret
       location-foreground-service uden brug er praecis den slags Play beder om
       en saerlig begrundelse for. Derfor ryger baade tilladelsen og servicen.

       FOREGROUND_SERVICE (uden _LOCATION) bliver: den bruges ogsaa af WebRTC's
       mediaProjection og notifees shortService. Verificeret i den merged
       manifest 28/9-2026 — kun LocationTaskService brugte type "location". -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
                   tools:node="remove"/>

  <!-- NB (28/9-2026): `<service>` hoerer under `<application>`. Laa den direkte
       under `<manifest>` — som tilladelserne — behandlede merger'en den som en
       DEKLARATION i stedet for en fjernelse, og resultatet var at servicen
       stadig stod i den merged manifest med bibliotekets attributter
       (`android:exported="false"`, `foregroundServiceType="location"`).
       Maalt i manifest-merger-blame-rapporten. Derfor denne nesting. -->
  <application>
    <service android:name="expo.modules.location.services.LocationTaskService"
             tools:node="remove"/>
  </application>
</manifest>
