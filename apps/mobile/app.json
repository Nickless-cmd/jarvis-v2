{
  "expo": {
    "name": "Jarvis",
    "slug": "jarvis-mobile",
    "version": "0.2.183",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "dk.srvlab.jarvis.mobile",
      "versionCode": 284,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/*"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Jarvis kan se din lokation n\u00e5r appen er \u00e5ben, s\u00e5 han ved hvor du er.",
          "locationAlwaysPermission": "Jarvis kan dele din pr\u00e6cise lokation i baggrunden, hvis du selv sl\u00e5r det til."
        }
      ],
      "expo-audio"
    ],
    "icon": "./assets/icon.png"
  }
}
