[Unit]
Description=Jarvis V2 API (HTTP/SSE/WebSocket only)
After=network.target
Wants=network.target

[Service]
Type=simple
User=bs
Group=bs
WorkingDirectory=/media/projects/jarvis-v2

ExecStart=/opt/conda/envs/ai/bin/uvicorn apps.api.jarvis_api.app:app \
    --host 0.0.0.0 \
    --port 80 \
    --workers 4 \
    --timeout-graceful-shutdown 5

Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=120s
StartLimitBurst=5

Environment=PYTHONPATH=/media/projects/jarvis-v2
Environment=PYTHONUNBUFFERED=1
Environment=JARVIS_VOICE_ENABLED=1
Environment=JARVIS_ENABLE_RUNTIME_SERVICES=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-api

# INGEN AmbientCapabilities. Linjen stod her indtil 13/9-2026 og braekkede
# bash-sandkassen fuldstaendigt: ambient capabilities arves ind i ETHVERT barn,
# ogsaa bwrap, og bubblewrap naegter bevidst at koere med capabilities uden at
# vaere setuid (containers/bubblewrap#380). Hvert eneste sandkasse-kald doede med
#   bwrap: Unexpected capabilities but not setuid, old file caps config?
# mens status() meldte «aktiv: True».
#
# Intet i koden bruger capabilities (nul traef paa os.setuid/setgid/prctl), og
# 443 ejes af Caddy — Jarvis sidder paa 8011/8080. De var altsaa overfloedige.
#
# CapabilityBoundingSet nedenfor BLIVER: den BEGRAENSER kun hvad processen maa
# faa, arves ikke som ambient, og er aegte hardening.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID

MemoryMax=16G
CPUQuota=800%

[Install]
WantedBy=multi-user.target
