[Unit]
Description=Jarvis V2 runtime owner (heartbeat, schedulers, bridges)
After=network.target
Wants=network.target
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=simple
User=bs
Group=bs
WorkingDirectory=/media/projects/jarvis-v2

ExecStart=/opt/conda/envs/ai/bin/uvicorn apps.api.jarvis_api.app:app \
    --host 127.0.0.1 \
    --port 8011 \
    --workers 1 \
    --timeout-graceful-shutdown 35

Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s

Environment=PYTHONPATH=/media/projects/jarvis-v2
Environment=PYTHONUNBUFFERED=1
Environment=JARVIS_VOICE_ENABLED=1
Environment=JARVIS_ENABLE_RUNTIME_SERVICES=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-runtime

# INGEN AmbientCapabilities. Linjen stod her indtil 13/9-2026 og braekkede
# bash-sandkassen fuldstaendigt: ambient capabilities arves ind i ETHVERT barn,
# ogsaa bwrap, og bubblewrap naegter bevidst at koere med capabilities uden at
# vaere setuid (containers/bubblewrap#380). Hvert eneste sandkasse-kald doede med
#   bwrap: Unexpected capabilities but not setuid, old file caps config?
# mens status() meldte «aktiv: True».
#
# Intet i koden bruger capabilities (nul traef paa os.setuid/setgid/prctl), og
# 443 ejes af Caddy — Jarvis sidder paa 8011/8080. De var altsaa overfloedige.
#
# CapabilityBoundingSet nedenfor BLIVER: den BEGRAENSER kun hvad processen maa
# faa, arves ikke som ambient, og er aegte hardening.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID

# Målt 10/11-2026: processen holder ~313 fd på jarvis.db alene (197 tråde, én
# pooled SQLite-forbindelse pr. tråd) mod en blød grænse på 1024. 9/11 kl. 13:52
# gav det EMFILE i jarvisx_auth — den kunne ikke læse runtime.json og lavede en
# midlertidig secret, så udstedte tokens ville dø ved næste genstart. Den hårde
# grænse var 524288 hele tiden; kun den bløde var lav.
LimitNOFILE=65536

MemoryMax=16G
CPUQuota=800%

[Install]
WantedBy=multi-user.target
